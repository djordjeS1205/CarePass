# Sepolia RPC endpoint (Alchemy, Infura, or any provider's Sepolia URL)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key

# Private key of a wallet funded with Sepolia test ETH only.
# NEVER put a mainnet / real-funds private key here.
PRIVATE_KEY=your-testnet-wallet-private-key

# Optional: Etherscan API key, only needed if you want `hardhat verify` to work.
ETHERSCAN_API_KEY=

# Set this after deploy.js prints the deployed address, so authorizeInstitution.js can use it.
CONTRACT_ADDRESS=
